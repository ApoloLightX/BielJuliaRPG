{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "types": ["vite/client", "node", "vitest/globals"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "api/**/*.js", "shared/**/*.js", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
