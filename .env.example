# IA do Mestre: somente no runtime/server da Vercel
GROQ_API_KEY=
# Opcional. O default de producao usa openai/gpt-oss-120b.
GROQ_MODEL=
GEMINI_API_KEY=

# Autenticacao do endpoint /api/mestre. Valores Supabase abaixo sao publicos.
SUPABASE_URL=https://xjbkvifjslllqdkwkymv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Emergencia/desenvolvimento apenas. Em producao mantenha false/ausente.
MESTRE_ALLOW_GUEST=false

# Frontend Supabase
VITE_SUPABASE_URL=https://xjbkvifjslllqdkwkymv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com anon key legada
VITE_SUPABASE_ANON_KEY=
# Exibe o modo local sem login. Para producao, mantenha false/ausente.
VITE_ENABLE_LOCAL_GUEST=false

# Nunca commite GROQ_API_KEY, GEMINI_API_KEY, service_role, tokens ou senhas.
